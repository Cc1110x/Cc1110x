from playwright.sync_api import sync_playwright
import tkinter as tk
from tkinter import messagebox
import pandas as pd
import threading

# 数据
results = []


# =========================
# 爬虫函数
# =========================
def scrape(keyword, text_box, btn):

    global results
    results = []

    try:

        with sync_playwright() as p:

            # 持久化登录
            context = p.chromium.launch_persistent_context(
                user_data_dir="douyin_user",
                headless=False
            )

            page = context.new_page()

            # 搜索页
            url = f"https://www.douyin.com/search/{keyword}"

            print("打开:", url)

            page.goto(
                url,
                wait_until="domcontentloaded",
                timeout=60000
            )

            # 第一次运行需要手动登录
            input("登录完成后按回车继续...")

            page.wait_for_timeout(5000)

            # 自动滚动加载
            for _ in range(8):

                page.mouse.wheel(0, 3000)

                page.wait_for_timeout(2000)

            # 用户卡片
            users = page.locator("a[href*='user']")

            count = users.count()

            print("用户数量:", count)

            seen = set()

            for i in range(count):

                try:

                    user = users.nth(i)

                    text = user.inner_text().strip()

                    href = user.get_attribute("href")

                    if not text:
                        continue

                    if len(text) < 2:
                        continue

                    # 提取用户ID
                    user_id = ""

                    if href:

                        if "/user/" in href:

                            user_id = href.split("/user/")[-1]

                            user_id = user_id.split("?")[0]

                    result = {
                        "关键词": keyword,
                        "用户名称": text,
                        "用户ID": user_id,
                        "链接": href
                    }

                    unique_key = str(result)

                    if unique_key in seen:
                        continue

                    seen.add(unique_key)

                    results.append(result)

                    show_text = (
                        f"用户: {text}\n"
                        f"ID: {user_id}\n"
                        f"链接: {href}\n"
                    )

                    print(show_text)

                    text_box.insert(
                        tk.END,
                        show_text + "\n"
                    )

                    text_box.see(tk.END)

                except:
                    continue

            # 导出 Excel
            if results:

                df = pd.DataFrame(results)

                save_path = (
                    r"C:\Users\Money\OneDrive\Desktop\douyin_user_ids.xlsx"
                )

                df.to_excel(
                    save_path,
                    index=False
                )

                messagebox.showinfo(
                    "成功",
                    f"已导出:\n{save_path}"
                )

            else:

                messagebox.showwarning(
                    "提示",
                    "没有抓到用户ID"
                )

            context.close()

    except Exception as e:

        print("ERROR:", e)

        messagebox.showerror(
            "错误",
            str(e)
        )

    finally:

        btn.config(state=tk.NORMAL)


# =========================
# 开始按钮
# =========================
def start_scrape(entry, text_box, btn):

    keyword = entry.get().strip()

    if not keyword:

        messagebox.showwarning(
            "提示",
            "请输入关键词"
        )

        return

    text_box.delete("1.0", tk.END)

    btn.config(state=tk.DISABLED)

    threading.Thread(
        target=scrape,
        args=(keyword, text_box, btn)
    ).start()


# =========================
# GUI
# =========================
app = tk.Tk()

app.title("抖音关键词用户ID采集工具")

app.geometry("850x650")


# 标题
label = tk.Label(
    app,
    text="输入关键词",
    font=("Arial", 14)
)

label.pack(pady=10)


# 输入框
entry = tk.Entry(
    app,
    width=40,
    font=("Arial", 12)
)

entry.pack(pady=5)


# 按钮
btn = tk.Button(
    app,
    text="开始采集用户ID",
    font=("Arial", 12),
    command=lambda: start_scrape(
        entry,
        text_box,
        btn
    )
)

btn.pack(pady=10)


# 文本框
text_box = tk.Text(
    app,
    height=35,
    font=("Arial", 10)
)

text_box.pack(
    fill=tk.BOTH,
    expand=True,
    padx=10,
    pady=10
)


# 主循环
app.mainloop()