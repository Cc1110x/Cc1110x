from playwright.sync_api import sync_playwright
import sqlite3
import re
import time

DB = "douyin.db"


# ======================
# DB初始化
# ======================
def init_db():
    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            keyword TEXT,
            name TEXT,
            douyin_id TEXT,
            url TEXT UNIQUE
        )
    """)

    conn.commit()
    conn.close()


# ======================
# 保存
# ======================
def save(keyword, name, douyin_id, url):

    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute("""
        INSERT OR IGNORE INTO users
        (keyword, name, douyin_id, url)
        VALUES (?, ?, ?, ?)
    """, (keyword, name, douyin_id, url))

    conn.commit()
    conn.close()


# ======================
# 提取抖音号
# ======================
def extract_id(html):

    m = re.search(r"抖音号[:：]\\s*([a-zA-Z0-9_\\-]+)", html)

    return m.group(1) if m else ""


# ======================
# 主逻辑
# ======================
def run(keyword):

    init_db()

    with sync_playwright() as p:

        context = p.chromium.launch_persistent_context(
            user_data_dir="douyin_user",
            headless=False
        )

        page = context.new_page()

        url = f"https://www.douyin.com/search/{keyword}"

        print("打开:", url)

        page.goto(url, wait_until="domcontentloaded")

        input("👉 登录  后回车继续...")

        # 分段等待（稳定关键）
        page.wait_for_timeout(3000)
        page.mouse.wheel(0, 2500)
        page.wait_for_timeout(2000)
        page.mouse.wheel(0, 2500)
        page.wait_for_timeout(2000)

        # 多选择器兜底
        users = page.locator("a[href*='/user/'], a[href*='user']")
        count = users.count()

        print("用户数:", count)

        seen = set()

        for i in range(min(count, 20)):  # 稳定版限制20

            try:

                u = users.nth(i)

                name = u.inner_text().strip()
                href = u.get_attribute("href")

                if not href:
                    continue

                full_url = (
                    "https://www.douyin.com" + href
                    if href.startswith("/")
                    else href
                )

                if full_url in seen:
                    continue

                seen.add(full_url)

                # ===== 打开详情页 =====
                detail = context.new_page()

                try:
                    detail.goto(full_url, wait_until="domcontentloaded", timeout=60000)
                    detail.wait_for_timeout(2500)

                    html = detail.content()

                    douyin_id = extract_id(html)

                    save(keyword, name, douyin_id, full_url)

                    print(f"{name} | {douyin_id}")

                except:
                    print("跳过用户")

                finally:
                    detail.close()

                time.sleep(1)  # ⭐防风控关键

            except:
                continue

        context.close()

        print("完成")


if __name__ == "__main__":
    run(input("输入关键词："))